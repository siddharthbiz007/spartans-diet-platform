# Server Configuration
PORT=5000
JWT_SECRET=spartans_secret_key_2026_super_secure_hash
NODE_ENV=production

# Email Service (SMTP) Configuration for sending real OTPs
# Option 1: Gmail (Generate App Password via Google Account -> Security -> 2-Step Verification -> App Passwords)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=xxxx_xxxx_xxxx_xxxx

# Option 2: Custom SMTP (Brevo, SendGrid, Mailgun, AWS SES, Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_NAME="AYUVA - Spartans Platform"
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
